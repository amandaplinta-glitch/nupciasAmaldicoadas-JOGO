<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.mycompany.nupciasamaldicoadas.IgrejaFrenteController">
    <VBox style="-fx-background-image: url('/com/mycompany/nupciasamaldicoadas/cenarioDia/IgrejaFrente.png');
 -fx-background-size: 100% 100%; -fx-background-repeat: no-repeat; -fx-background-position: center;" prefWidth="650.0" prefHeight="600.0">
        
       <!-- 1. Controla a altura (o "Y" de cima para baixo) para o botão do meio -->
        <Region prefHeight="280.0" />
        
        <!-- Botão "Interior": Controla a posição horizontal (o "X") usando margem esquerda -->
        <HBox>
            <children>
                <Button fx:id="btnLocomocao" text="Interior" onAction="#mudarInterior"/>
            </children>
            <padding>
                <Insets left="280.0" /> <!-- Altere aqui para mover o botão para a esquerda ou direita -->
            </padding>
        </HBox>
        
        <!-- 2. Espaçador flexível que empurra o botão do celular para o rodapé -->
        <Region VBox.vgrow="ALWAYS" />
        
        <!-- Botão "Celular": Fixo no canto inferior esquerdo -->
        <HBox alignment="BOTTOM_LEFT">
            <Button fx:id="btnLoja" text="Celular" onAction="#irLoja"/>
            <padding>
                <Insets bottom="20.0" left="20.0" />
            </padding>
        </HBox>
        
    </VBox>
   
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
